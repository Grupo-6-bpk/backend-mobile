        "responses": {
          "200": {
            "description": "Passenger validation rejected successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResponse"
                }
              },
              "application/xml": {
                "schema": {
