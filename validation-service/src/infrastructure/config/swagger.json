              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DriverValidation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "cnh": {
            "type": "string",
            "example": "12345678901"
          },
          "cnh_front": {
            "type": "string",
            "example": "https://example.com/cnh_front.jpg"
          },
          "cnh_back": {
            "type": "string",
            "example": "https://example.com/cnh_back.jpg"
          },
          "bpk_link": {
            "type": "string",
            "example": "https://example.com/bpk_document.pdf"
          },
          "user_id": {
            "type": "number",
            "example": 123
          },
          "is_validated": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "example": "2025-06-13T10:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2025-06-13T10:00:00Z"
          }
        },
        "xml": {
          "name": "DriverValidation"
        }
      },
      "PassengerValidation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "rg_front": {
            "type": "string",
            "example": "https://example.com/rg_front.jpg"
          },
          "rg_back": {
            "type": "string",
            "example": "https://example.com/rg_back.jpg"
          },
          "bpk_link": {
            "type": "string",
            "example": "https://example.com/bpk_document.pdf"
          },
          "user_id": {
            "type": "number",
            "example": 456
          },
          "is_validated": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "example": "2025-06-13T10:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2025-06-13T10:00:00Z"
          }
        },
        "xml": {
          "name": "PassengerValidation"
        }
      },
      "ValidationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Driver validation accepted successfully"
          }
        },
        "xml": {
          "name": "ValidationResponse"
        }
      },
      "ValidationListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number",
                  "example": 1
                },
                "cnh": {
                  "type": "string",
                  "example": "12345678901"
                },
                "cnh_front": {
                  "type": "string",
                  "example": "https://example.com/cnh_front.jpg"
                },
                "cnh_back": {
                  "type": "string",
                  "example": "https://example.com/cnh_back.jpg"
                },
                "bpk_link": {
                  "type": "string",
                  "example": "https://example.com/bpk_document.pdf"
                },
                "user_id": {
                  "type": "number",
                  "example": 123
                },
                "is_validated": {
                  "type": "boolean",
                  "example": false
                },
                "createdAt": {
                  "type": "string",
                  "example": "2025-06-13T10:00:00Z"
                },
                "updatedAt": {
                  "type": "string",
                  "example": "2025-06-13T10:00:00Z"
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "totalData": {
                "type": "number",
                "example": 15
              },
              "totalPages": {
                "type": "number",
                "example": 2
              },
              "currentPage": {
                "type": "number",
                "example": 1
              },
              "pageSize": {
                "type": "number",
                "example": 10
              }
            }
          }
        },
        "xml": {
          "name": "ValidationListResponse"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Validation not found"
          }
        },
        "xml": {
          "name": "ErrorResponse"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}